{% endfor %}
 \end{itemize}

%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
{% for edu in education %}
    \resumeSubheading
      {{ edu.institution | braced }}{{ edu.location | braced }}
      {{ edu.degree | braced }}{{ edu.dates | braced }}
